{
  "name": "little-school",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build && node scripts/check-compat.mjs && node scripts/check-precache.mjs",
    "check:compat": "node scripts/check-compat.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "icons": "node scripts/make-icons.mjs",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tests",
    "check:precache": "node scripts/check-precache.mjs",
    "voice:list": "node scripts/voice-list.mjs",
    "voice:make": "node scripts/voice-make.mjs",
    "voice:mark": "node scripts/voice-mark.mjs",
    "voice:check": "node scripts/voice-check.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "acorn": "^8.19.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vite-plugin-pwa": "^0.21.2",
    "vitest": "^2.1.4",
    "workbox-window": "^7.4.1"
  }
}
